# ─────────────────────────────────────────────
# Spoticord – Environment Configuration
# Copy to .env and fill in every value
# ─────────────────────────────────────────────

# ── Spotify device account (host / fallback) ──
# A Spotify Premium account used to register the Pi as a speaker.
# This does NOT need to be your personal account – a dedicated one works fine.
SPOTIFY_USERNAME=host_account@example.com
SPOTIFY_PASSWORD=host_account_password

# Name shown in Spotify's device list
SPOTIFY_DEVICE_NAME=SpoticordPi

# 96 | 160 | 320
SPOTIFY_BITRATE=320
SPOTIFY_VOLUME=80

# ── Spotify app (for OAuth) ───────────────────
# Create at https://developer.spotify.com/dashboard
# Add SPOTIFY_REDIRECT_URI to the app's Redirect URIs list
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Optional: one Discord user ID whose linked Spotify token is used for all !start calls.
# Set this to allow everyone to start without linking personal Spotify accounts.
SPOTIFY_CONTROLLER_MODE=requester
SPOTIFY_SHARED_DISCORD_ID=

# Must be publicly reachable – your Cloudflare Tunnel domain
# Example: https://spoticord.yourdomain.com/callback
SPOTIFY_REDIRECT_URI=https://spoticord.yourdomain.com/callback

# ── Discord ───────────────────────────────────
# From https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token
DISCORD_PREFIX=!
# App name used in embeds and bot UI text
APP_NAME=Spoticord
# Bot profile status text shown as "Listening to ..."
DISCORD_ACTIVITY_TEXT=Spotify Connect
# Activity type: PLAYING | LISTENING | WATCHING | STREAMING | COMPETING
DISCORD_ACTIVITY_TYPE=LISTENING
# If true, bot may auto-connect from saved channel config even without active session
AUTO_JOIN_WITHOUT_SESSION=false
# Grace window before stopping session when host temporarily drops from voice (ms)
HOST_LEAVE_GRACE_MS=15000
# Restart watchdog for encoder restarts per guild per minute
MAX_RESTARTS_PER_MIN=10
# Local health endpoint port for discord-bot container
BOT_HEALTH_PORT=7070
# File used to persist restart watchdog counters
RESTART_STATE_FILE=/data/restart_state.json
# Optional CSV role IDs granted command moderation access (e.g. setchannel/restart/host transfer)
MOD_ROLE_IDS=
# Optional CSV role IDs treated as admin access for command policy
ADMIN_ROLE_IDS=

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
